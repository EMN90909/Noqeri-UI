// Copy src/components.noqeri to noqeri/components.noqeri before building.
import "noqeri/components" as ui

let count = 0
let email = ""
theme {
    primary: "#fb5607"
    background: "#f8fafc"
    surface: "#ffffff"
    text: "#182333"
    border: "#dbe1e9"
    radius: 12
}
route "/" {
    main class: "nui-root" {
        div class: "nui-container nui-stack" {
            nav class: "nui-navbar" {
                ui.NavLink("Home", "/")
                ui.NavLink("Components", "/components")
            }
            ui.Hero("INTRODUCING NOQERI UI", "Build something extraordinary.", "Beautiful defaults, native Noqeri source, and components you can actually customize.")
            div class: "nui-group" {
                ui.LinkButton("Explore components", "/components")
                ui.SecondaryLink("View examples", "/components")
            }
            ui.SectionHeading("Built for real applications", "Forms, feedback, layouts, navigation, and meaningful interaction.")
            div class: "nui-grid" {
                ui.FeatureCard("DESIGN TOKENS", "Your brand, your rules", "Change color and spacing once. Your interface follows.")
                ui.FeatureCard("ACCESSIBILITY", "Semantic HTML", "Labels, browser validation, focus states and reduced-motion support.")
                ui.FeatureCard("NO REACT REQUIRED", "One language", "Authored in Noqeri and compiled to browser standards.")
            }
            ui.FooterNote("Noqeri UI. Open source, MIT licensed.")
        }
    }
}
route "/components" {
    main class: "nui-root" {
        div class: "nui-container nui-stack" {
            nav class: "nui-navbar" { ui.NavLink("Home", "/") ui.NavLink("Components", "/components") }
            ui.PageHeader("COMPONENT SHOWCASE", "The component workshop", "A tiny application exercising the real view compiler.")
            div class: "nui-group" {
                ui.Badge("Default") ui.BadgeSuccess("Connected") ui.BadgeWarning("Pending") ui.BadgeDanger("Failed")
            }
            div class: "nui-grid" {
                ui.Card("Cards", "Lightweight semantic panels with sensible defaults.")
                ui.StatCard("Monthly users", "2,481", "+12.4% this month")
                ui.AlertSuccess("All systems running", "Your service is responding normally.")
            }
            ui.SectionHeading("Working interactions", "The browser event/state mechanism is the one already provided by Noqeri.")
            div class: "nui-group" {
                p class: "nui-text" { "Count: " + count }
                button class: "nui-button" type: "button" on.click { count = count + 1 } { "Increment" }
                button class: "nui-button nui-button-secondary" type: "button" on.click { count = 0 } { "Reset" }
            }
            ui.SectionHeading("Forms", "Native input, focus, and required-field validation.")
            form class: "nui-stack" on.submit { email = form.email } {
                div class: "nui-field" {
                    label class: "nui-label" for: "email" { "Work email" }
                    input id: "email" name: "email" class: "nui-input" type: "email" placeholder: "name@example.com" required: true {}
                }
                button type: "submit" class: "nui-button" { "Save email" }
            }
            p class: "nui-muted" { "Last submitted: " + email }
            ui.Field("Project name", "project_name", "A new idea")
            ui.SelectThree("Priority", "priority", "Low", "Normal", "High")
            ui.Checkbox("Enable notifications", "notifications")
            ui.Switch("Dark mode preference", "dark_mode")
            ui.SectionHeading("Native disclosure", "Fully interactive without custom JavaScript event code.")
            ui.AccordionItem("What's inside?", "A details and summary element with browser-native keyboard behavior.")
            ui.ProgressThreeQuarters("Upload progress")
            ui.EmptyState("Nothing here yet", "Your future content will appear in this space.")
            ui.FooterNote("Noqeri UI · Component showcase")
        }
    }
}
view { main class: "nui-root" { ui.EmptyState("Page not found", "Try the home route.") } }
